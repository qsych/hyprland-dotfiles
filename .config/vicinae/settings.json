{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "family": "Outfit"
      }
   },
   "theme": {
      "dark": {
         "name": "kanagawa-dragon-mono"
      }
   },
   "launcher_window": {
      "opacity": 0.84,
      "material": "none",
      "compact_mode": {
         "enabled": false
      }
   },
   "favorites": [
      "@Gelei/store.vicinae.bluetooth:devices",
      "@dagimg-dot/store.vicinae.wifi-commander:manage-saved-networks",
      "clipboard:history"
   ],
   "providers": {
      "@dagimg-dot/store.vicinae.wifi-commander": {
         "preferences": {
            "network-cli-tool": "nmcli"
         }
      },
      "browser-extension": {
         "entrypoints": {
            "browse-tabs": {
               "enabled": false
            },
            "shortcut-active-tab": {
               "enabled": false
            }
         }
      }
   }
}
